@@ -0,0 +1,94 @@
+// Greengram: delete the account from Settings. The password is checked by
+// the instance over HTTPS (it never goes over MTProto), then
+// account.deleteAccount runs and the app signs out.
+
+import { memo, useEffect, useState } from '../../../lib/teact/teact';
+import { getActions } from '../../../global';
+
+import { callApi } from '../../../api/gramjs';
+
+import useLang from '../../../hooks/useLang';
+import useLastCallback from '../../../hooks/useLastCallback';
+
+import PasswordForm from '../../common/PasswordForm';
+import PasswordMonkey from '../../common/PasswordMonkey';
+import ConfirmDialog from '../../ui/ConfirmDialog';
+
+type OwnProps = {
+  isOpen: boolean;
+  onClose: NoneToVoidFunction;
+};
+
+const DeleteMyAccountModal = ({ isOpen, onClose }: OwnProps) => {
+  const { signOut } = getActions();
+  const lang = useLang();
+
+  const [hasPassword, setHasPassword] = useState(true);
+  const [password, setPassword] = useState('');
+  const [isPasswordVisible, setIsPasswordVisible] = useState(false);
+  const [error, setError] = useState<string | undefined>();
+  const [isLoading, setIsLoading] = useState(false);
+
+  useEffect(() => {
+    if (!isOpen) return;
+    callApi('fetchGreengramDeletion').then((info) => {
+      if (info) setHasPassword(info.hasPassword);
+    });
+  }, [isOpen]);
+
+  const handleClose = useLastCallback(() => {
+    if (isLoading) return;
+    setPassword('');
+    setError(undefined);
+    setIsPasswordVisible(false);
+    onClose();
+  });
+
+  const handleClearError = useLastCallback(() => {
+    setError(undefined);
+  });
+
+  const handleConfirm = useLastCallback(async () => {
+    if (isLoading || (hasPassword && !password)) return;
+    setIsLoading(true);
+    setError(undefined);
+    const result = await callApi('deleteGreengramAccount', { password, reason: 'Deleted from Settings' });
+    if (!result || result.error) {
+      setIsLoading(false);
+      setError(result?.error || lang('ErrorUnexpected'));
+      return;
+    }
+    signOut({ forceInitApi: true });
+  });
+
+  return (
+    <ConfirmDialog
+      isOpen={isOpen}
+      title={lang('GreengramDeleteAccountTitle')}
+      confirmLabel={lang('GreengramDeleteAccountConfirm')}
+      confirmHandler={handleConfirm}
+      confirmIsDestructive
+      isConfirmDisabled={isLoading || (hasPassword && !password)}
+      onClose={handleClose}
+    >
+      <p>{lang('GreengramDeleteAccountText')}</p>
+      {hasPassword ? (
+        <>
+          <PasswordMonkey isPasswordVisible={isPasswordVisible} />
+          <PasswordForm
+            error={error}
+            placeholder={lang('GreengramDeleteAccountPassword')}
+            isLoading={isLoading}
+            isPasswordVisible={isPasswordVisible}
+            shouldDisablePasswordManager
+            onChangePasswordVisibility={setIsPasswordVisible}
+            onClearError={handleClearError}
+            onInputChange={setPassword}
+          />
+        </>
+      ) : error && <p className="error">{error}</p>}
+    </ConfirmDialog>
+  );
